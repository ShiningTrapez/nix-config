prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

// Fix for Electron Focus State
// https://github.com/niri-wm/niri/wiki/Configuration:-Debug-Options#deactivate-unfocused-windows
debug {
  deactivate-unfocused-windows
}

cursor {
  hide-after-inactive-ms 1000
}

hotkey-overlay {
  skip-at-startup
  hide-not-bound
}
